{
  "name": "pmntcode/mvc",
  "description": "Lightweight PHP 8.2+ MVC foundation with routing, views and layouts",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "PmntCode\\Mvc\\": "src/",
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  }
}
